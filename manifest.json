{
  "manifest_version": 3,
  "name": "YT Music Dusk",
  "version": "0.4",
  "description": "Custom animated theme for YouTube Music.",
  "host_permissions": [
  "http://localhost:3030/*"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "css": ["content.css"],
      "js": ["content.js"]
    }
  ]
}

